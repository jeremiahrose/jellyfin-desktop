option(ENABLE_DEFAULT_AUDIO_OUTPUT_VOLUME "Use the default audio output's volume as the only volume, set by the player, CEC and AirPlay" OFF)
if(ENABLE_DEFAULT_AUDIO_OUTPUT_VOLUME)
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(PULSEAUDIO REQUIRED libpulse)
  add_definitions(-DHAVE_DEFAULT_AUDIO_OUTPUT_VOLUME)
  include_directories(${PULSEAUDIO_INCLUDE_DIRS})
  list(APPEND EXTRA_LIBS ${PULSEAUDIO_LINK_LIBRARIES})
  message(STATUS "Enabling the default audio output volume as the only volume")
endif()
