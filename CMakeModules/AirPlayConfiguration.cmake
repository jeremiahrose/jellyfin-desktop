option(ENABLE_AIRPLAY "Receive AirPlay audio with libshairplay" OFF)
if(ENABLE_AIRPLAY)
  find_package(PkgConfig REQUIRED)
  find_path(SHAIRPLAY_INCLUDE_DIR shairplay/raop.h REQUIRED)
  find_library(SHAIRPLAY_LIBRARY shairplay REQUIRED)
  pkg_check_modules(AVAHI_CLIENT REQUIRED avahi-client)
  pkg_check_modules(PULSEAUDIO_SIMPLE REQUIRED libpulse-simple)

  add_definitions(-DHAVE_AIRPLAY)
  include_directories(${SHAIRPLAY_INCLUDE_DIR} ${AVAHI_CLIENT_INCLUDE_DIRS} ${PULSEAUDIO_SIMPLE_INCLUDE_DIRS})
  list(APPEND EXTRA_LIBS ${SHAIRPLAY_LIBRARY} ${AVAHI_CLIENT_LINK_LIBRARIES} ${PULSEAUDIO_SIMPLE_LINK_LIBRARIES})
  message(STATUS "Enabling AirPlay audio receiver")
endif()
